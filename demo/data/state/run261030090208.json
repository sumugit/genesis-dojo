{"exp":"run261030090208","synthetic":false,"criteria":[{"metric":"early_terminations","rule":"= 0","min_fraction":null,"comment":"途中で倒れて打ち切られない"},{"metric":"all_feet_up_max","rule":"1 以上","min_fraction":null,"comment":"窓内で少なくとも1回は4本とも空中に浮く（跳ねている）"},{"metric":"all_feet_up_mean","rule":"0.1〜0.7","min_fraction":null,"comment":"浮いている時間が適度にある。常に浮いたり、全く浮かなかったりしない"},{"metric":"front_step_count_min","rule":"2 以上","min_fraction":null,"comment":"前の左右の足がそれぞれ2回以上持ち上がる（繰り返し跳ねる）"},{"metric":"rear_step_count_min","rule":"2 以上","min_fraction":null,"comment":"後ろの左右の足がそれぞれ2回以上持ち上がる（繰り返し跳ねる）"},{"metric":"xy_dist_range_m","rule":"0.8 以上","min_fraction":null,"comment":"窓内で水平に0.8m以上進む（その場跳びではない）"},{"metric":"xy_max_dist_m","rule":"1.5 以上","min_fraction":null,"comment":"開始位置から1.5m以上離れる"},{"metric":"yaw_total_deg","rule":"-60〜60","min_fraction":null,"comment":"ほぼまっすぐ進む（大きく旋回しない）"},{"metric":"yaw_rate_abs_deg_s","rule":"60 以下","min_fraction":0.9,"comment":"旋回速度が小さい"},{"metric":"height_m","rule":"0.15〜0.55","min_fraction":0.9,"comment":"胴体の高さが立位から跳躍の範囲に収まる（潰れたり暴れたりしない）"},{"metric":"nose_up_deg","rule":"-30〜30","min_fraction":0.9,"comment":"前後の傾きが小さい（逆立ちや後ろ足立ちにならない）"},{"metric":"roll_deg_abs","rule":"30 以下","min_fraction":0.9,"comment":"横に大きく傾かない"},{"metric":"head_z_m","rule":"0.15 以上","min_fraction":0.9,"comment":"頭を地面に着けて支えない"},{"metric":"front_knee_z_min_m","rule":"0.06 以上","min_fraction":0.9,"comment":"肘を地面に着けて支えない"}],"window_s":[3,8],"instruction":"ウサギのように跳ねて前に進んで","task":"bunny_hop","max_loops":3,"stop_reason":"success","run_summary":{"stop_reason":"success","loops":1,"llm_cost_usd_equiv":0.124,"total_seconds":503.8,"disagreements":[]},"spec_sha256":"6aa415eadf89","hint":null,"prev_exp":null,"t_run_end":1793351439.263,"loops":[{"loop":1,"name":"run261030090208_L1","stages":{"reward":{"start":1793350935.418,"end":1793350965.675,"status":"done"},"check":{"start":1793350965.655,"end":1793350965.675,"status":"done"},"train":{"start":1793350965.68,"end":1793351397.346,"status":"done"},"record":{"start":1793351397.348,"end":1793351432.618,"status":"done"},"numeric":{"start":1793351432.619,"end":1793351432.619,"status":"done"},"vlm":{"start":1793351432.62,"end":1793351439.263,"status":"done"},"decision":{"start":1793351439.263,"end":1793351439.263,"status":"done"}},"reward_summary":"前進速度を主報酬にし、4本とも浮く瞬間を「前進しているときだけ」褒めることで、その場跳びや歩行ではなく前進するホップを促します。前後の左右の足の高さをそろえる項で兎らしい同期した跳ね方にし、頭・肘の接地、傾き、旋回、高さの逸脱には罰則を与えて逆立ちなどの抜け道を塞ぎます。","reward_code":"import math\nimport torch\nfrom pai_loop.task_env import nose_up_angle, roll_angle\n\nPARAMS = {\n    \"v_target\": 1.0,          # 目標前進速度 [m/s]\n    \"air_thresh\": 0.05,       # この高さ以上なら足は空中とみなす [m]\n    \"air_gate_v\": 0.5,        # 空中報酬が全開になる前進速度 [m/s]\n    \"w_fwd_lin\": 2.0,\n    \"w_fwd_exp\": 1.0,\n    \"fwd_exp_sigma\": 0.5,\n    \"w_air\": 2.0,\n    \"w_sync\": 4.0,\n    \"sync_clip\": 0.2,\n    \"w_lat\": 1.0,\n    \"w_yawrate\": 0.5,\n    \"w_yaw\": 0.5,\n    \"pitch_free\": 0.3,        # [rad] これを超えた分を罰する\n    \"w_pitch\": 5.0,\n    \"roll_free\": 0.2,\n    \"w_roll\": 3.0,\n    \"head_min\": 0.22,\n    \"w_head\": 10.0,\n    \"knee_min\": 0.08,\n    \"w_knee\": 10.0,\n    \"h_lo\": 0.18,\n    \"h_hi\": 0.50,\n    \"w_height\": 10.0,\n    \"w_hip\": 0.5,\n    \"w_action_rate\": 0.01,\n    \"w_dof_vel\": 1e-4,\n    # 終了条件（成功基準より緩めにして、立ち上がり直後の誤終了を避ける）\n    \"grace_s\": 0.6,\n    \"fail_pitch\": 0.75,       # [rad] 約43度\n    \"fail_roll\": 0.8,         # [rad] 約46度\n    \"fail_height\": 0.12,\n    \"fail_head_z\": 0.08,\n}\n\n\ndef _yaw(q):\n    w, x, y, z = q[:, 0], q[:, 1], q[:, 2], q[:, 3]\n    return torch.atan2(2.0 * (w * z + x * y), torch.clamp(1.0 - 2.0 * (y * y + z * z), -1.0, 1.0))\n\n\ndef compute(s, p):\n    z_feet = s.feet_pos[..., 2]                       # (N,4) FL, FR, RL, RR\n    air = (z_feet > p[\"air_thresh\"]).float()\n    all_air = air.min(dim=1).values\n\n    vx = s.lin_vel_b[:, 0]\n    vy = s.lin_vel_b[:, 1]\n    wz = s.ang_vel_b[:, 2]\n\n    r = {}\n    # 前進\n    r[\"fwd_lin\"] = p[\"w_fwd_lin\"] * torch.clamp(vx, -0.5, p[\"v_target\"]) / p[\"v_target\"]\n    r[\"fwd_exp\"] = p[\"w_fwd_exp\"] * torch.exp(-((vx - p[\"v_target\"]) ** 2) / p[\"fwd_exp_sigma\"] ** 2)\n\n    # 前進しながら4本とも浮く（跳ねる）\n    gate = torch.clamp(vx / p[\"air_gate_v\"], 0.0, 1.0)\n    r[\"hop_air\"] = p[\"w_air\"] * all_air * gate\n\n    # 前足同士・後ろ足同士の高さをそろえる（ウサギ跳び）\n    c = p[\"sync_clip\"]\n    d_front = torch.clamp((z_feet[:, 0] - z_feet[:, 1]).abs(), 0.0, c)\n    d_rear = torch.clamp((z_feet[:, 2] - z_feet[:, 3]).abs(), 0.0, c)\n    r[\"sync\"] = -p[\"w_sync\"] * (d_front + d_rear)\n\n    # まっすぐ進む\n    r[\"lat\"] = -p[\"w_lat\"] * torch.clamp(vy ** 2, 0.0, 4.0)\n    r[\"yawrate\"] = -p[\"w_yawrate\"] * torch.clamp(wz ** 2, 0.0, 9.0)\n    yaw = _yaw(s.base_quat)\n    r[\"yaw\"] = -p[\"w_yaw\"] * torch.clamp(yaw ** 2, 0.0, 4.0)\n\n    # 姿勢\n    pitch = nose_up_angle(s.gravity_b)\n    roll = roll_angle(s.gravity_b)\n    r[\"pitch\"] = -p[\"w_pitch\"] * torch.clamp(pitch.abs() - p[\"pitch_free\"], 0.0, 1.0) ** 2\n    r[\"roll\"] = -p[\"w_roll\"] * torch.clamp(roll.abs() - p[\"roll_free\"], 0.0, 1.0) ** 2\n\n    # 頭・肘で支えない\n    r[\"head\"] = -p[\"w_head\"] * torch.clamp(p[\"head_min\"] - s.head_pos[:, 2], 0.0, 0.3)\n    knee_z = s.knee_pos[..., 2]\n    front_knee = knee_z[:, 0:2]\n    r[\"knee\"] = -p[\"w_knee\"] * torch.clamp(p[\"knee_min\"] - front_knee, 0.0, 0.1).sum(dim=1)\n\n    # 胴体高さを範囲内に\n    h = s.base_pos[:, 2]\n    out = torch.clamp(p[\"h_lo\"] - h, 0.0, 0.3) + torch.clamp(h - p[\"h_hi\"], 0.0, 0.5)\n    r[\"height\"] = -p[\"w_height\"] * out\n\n    # 正則化\n    hip_idx = [0, 3, 6, 9]\n    r[\"hip\"] = -p[\"w_hip\"] * ((s.dof_pos[:, hip_idx] - s.default_dof_pos[hip_idx]) ** 2).sum(dim=1)\n    r[\"act_rate\"] = -p[\"w_action_rate\"] * ((s.actions - s.last_actions) ** 2).sum(dim=1)\n    r[\"dof_vel\"] = -p[\"w_dof_vel\"] * torch.clamp(s.dof_vel ** 2, 0.0, 400.0).sum(dim=1)\n\n    for k in r:\n        r[k] = torch.nan_to_num(r[k], nan=0.0, posinf=0.0, neginf=0.0)\n    return r\n\n\ndef failed(s, p):\n    pitch = nose_up_angle(s.gravity_b)\n    roll = roll_angle(s.gravity_b)\n    late = s.episode_time > p[\"grace_s\"]\n    bad = (\n        (pitch.abs() > p[\"fail_pitch\"])\n        | (roll.abs() > p[\"fail_roll\"])\n        | (s.base_pos[:, 2] < p[\"fail_height\"])\n        | (s.head_pos[:, 2] < p[\"fail_head_z\"])\n    )\n    return bad & late\n","check_attempts":[{"attempt":1,"ok":false,"message":null},{"attempt":1,"ok":true,"message":null}],"train":{"seconds":373.5,"final_mean_reward":29.013,"iterations":null,"iteration":599,"total":600,"curve":[[0,-0.22],[1,-0.83],[2,-1.24],[3,-1.52],[4,-1.62],[5,-1.74],[6,-1.84],[7,-1.89],[8,-2.01],[9,-2.34],[10,-2.62],[11,-2.77],[12,-2.69],[13,-2.4],[14,-1.79],[15,-1.94],[16,-1.53],[17,-1.46],[18,-1.29],[19,-0.99],[20,-1.03],[21,-0.91],[22,-0.89],[23,-0.84],[24,-0.87],[25,-0.73],[26,-0.62],[27,-0.44],[28,-0.29],[29,-0.16],[30,-0.15],[31,-0.04],[32,-0.01],[33,0.06],[34,0.21],[35,0.18],[36,0.22],[37,0.32],[38,0.35],[39,0.47],[40,0.53],[41,0.58],[42,0.62],[43,0.69],[44,0.69],[45,0.73],[46,0.78],[47,0.77],[48,0.84],[49,0.86],[50,0.88],[51,0.91],[52,0.93],[53,0.94],[54,0.99],[55,0.99],[56,1.01],[57,1.03],[58,1.06],[59,1.09],[60,1.12],[61,1.12],[62,1.14],[63,1.15],[64,1.14],[65,1.19],[66,1.19],[67,1.2],[68,1.2],[69,1.24],[70,1.26],[71,1.25],[72,1.26],[73,1.29],[74,1.29],[75,1.31],[76,1.3],[77,1.33],[78,1.35],[79,1.35],[80,1.36],[81,1.38],[82,1.38],[83,1.39],[84,1.38],[85,1.41],[86,1.42],[87,1.41],[88,1.42],[89,1.45],[90,1.47],[91,1.47],[92,1.47],[93,1.48],[94,1.49],[95,1.5],[96,1.51],[97,1.5],[98,1.51],[99,1.51],[100,1.53],[101,1.54],[102,1.54],[103,1.55],[104,1.56],[105,1.56],[106,1.59],[107,1.59],[108,1.57],[109,1.61],[110,1.62],[111,1.63],[112,1.65],[113,1.66],[114,1.66],[115,1.66],[116,1.68],[117,1.7],[118,1.68],[119,1.72],[120,1.72],[121,1.75],[122,1.75],[123,1.75],[124,1.78],[125,1.79],[126,1.81],[127,1.85],[128,1.85],[129,1.85],[130,1.88],[131,1.88],[132,1.95],[133,1.95],[134,1.96],[135,2.06],[136,2.09],