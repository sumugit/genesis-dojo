:"done"},"decision":{"start":1793199922.231,"end":1793199922.231,"status":"done"}},"reward_summary":"トロット（FL+RRとFR+RLの対角ペア）の位相に合わせた足の高さを主報酬とし、立位・水平姿勢でゲートした前進速度項で、まっすぐ0.4m/s前後で歩かせる。跳躍・膝や頭の接地・過度な傾きは罰し、失敗は明らかな転倒だけに限る。","reward_code":"import math\nimport torch\nfrom pai_loop.task_env import nose_up_angle, roll_angle\n\nPARAMS = {\n    \"gait_freq_hz\": 1.5,\n    \"swing_target_z\": 0.08,\n    \"swing_min_z\": 0.06,\n    \"stance_max_z\": 0.04,\n    \"foot_rest_z\": 0.023,\n    \"v_target\": 0.45,\n    \"v_sigma\": 0.2,\n    \"lat_sigma\": 0.15,\n    \"yaw_sigma\": 0.4,\n    \"height_target\": 0.29,\n    \"height_sigma\": 0.04,\n    \"tilt_sigma\": 0.15,\n    \"knee_min_z\": 0.12,\n    \"head_min_z\": 0.20,\n    \"w_gait\": 3.0,\n    \"w_swing_peak\": 1.0,\n    \"w_stance\": 1.0,\n    \"w_vel\": 1.5,\n    \"w_lat\": 0.5,\n    \"w_yaw\": 0.5,\n    \"w_height\": 1.5,\n    \"w_tilt\": 1.5,\n    \"w_all_up\": -3.0,\n    \"w_knee\": -3.0,\n    \"w_head\": -3.0,\n    \"w_action_rate\": -0.02,\n    \"w_dof_vel\": -0.0005,\n    \"w_pose\": -0.2,\n    \"fail_height\": 0.15,\n    \"fail_roll\": 0.9,\n    \"fail_pitch\": 0.9,\n}\n\n\ndef _schedule(s, p):\n    phase = 2.0 * math.pi * p[\"gait_freq_hz\"] * s.episode_time\n    a = (torch.sin(phase) > 0).float()  # 1: FL,RR 遊脚\n    # 順序 FL, FR, RL, RR\n    swing = torch.stack([a, 1 - a, 1 - a, a], dim=1)\n    return swing\n\n\ndef compute(s, p):\n    z = s.feet_pos[..., 2]  # (N,4)\n    swing = _schedule(s, p)\n    stance = 1.0 - swing\n\n    h = s.base_pos[:, 2]\n    pitch = nose_up_angle(s.gravity_b)\n    roll = roll_angle(s.gravity_b)\n\n    upright = torch.exp(-((h - p[\"height_target\"]) / p[\"height_sigma\"]) ** 2)\n    tilt = torch.exp(-(pitch ** 2 + roll ** 2) / p[\"tilt_sigma\"] ** 2)\n    gate = upright * tilt  # 立てているときだけ歩行報酬が効く\n\n    # 遊脚は目標高さへ、支持脚は低く\n    swing_err = torch.clamp(p[\"swing_target_z\"] - z, min=0.0) / p[\"swing_target_z\"]\n    swing_r = (swing * (1.0 - torch.clamp(swing_err, 0.0, 1.0))).sum(1) / 2.0\n    over = torch.clamp(z - 0.11, min=0.0) * swing * 10.0\n    swing_r = swing_r - over.sum(1)\n    stance_err = torch.clamp(z - p[\"stance_max_z\"], min=0.0) / 0.04\n    stance_r = (stance * torch.exp(-stance_err)).sum(1) / 2.0 - 1.0 * 0\n    stance_pen = (stance * torch.clamp(stance_err, 0.0, 2.0)).sum(1) / 2.0\n\n    # 遊脚が閾値を超えるピーク（実際に足が上がる）\n    peak = (swing * torch.clamp((z - p[\"foot_rest_z\"]) / (p[\"swing_min_z\"] - p[\"foot_rest_z\"]), 0.0, 1.0)).sum(1) / 2.0\n\n    # 跳躍：接地している足が2本未満\n    lifted = (z > 0.05).float()\n    n_up = lifted.sum(1)\n    all_up = (n_up >= 3.5).float() + 0.5 * (n_up >= 2.5).float() * (n_up < 3.5).float()\n\n    vx = s.lin_vel_b[:, 0]\n    vel = torch.exp(-((vx - p[\"v_target\"]) / p[\"v_sigma\"]) ** 2)\n    lat = torch.exp(-(s.lin_vel_b[:, 1] / p[\"lat_sigma\"]) ** 2)\n    yaw = torch.exp(-(s.ang_vel_b[:, 2] / p[\"yaw_sigma\"]) ** 2)\n\n    knee_low = torch.clamp(p[\"knee_min_z\"] - s.knee_pos[..., 2], min=0.0).sum(1)\n    head_low = torch.clamp(p[\"head_min_z\"] - s.head_pos[:, 2], min=0.0)\n\n    da = s.actions - s.last_actions\n    pose_dev = ((s.dof_pos - s.default_dof_pos) ** 2).sum(1)\n\n    return {\n        \"gait\": p[\"w_gait\"] * gate * swing_r.clamp(min=-1.0),\n        \"peak\": p[\"w_swing_peak\"] * gate * peak,\n        \"stance\": -p[\"w_stance\"] * gate * stance_pen,\n        \"vel\": p[\"w_vel\"] * gate * vel * lat * yaw * (0.3 + 0.7 * peak),\n        \"lat\": p[\"w_lat\"] * gate * lat,\n        \"yaw\": p[\"w_yaw\"] * gate * yaw,\n        \"height\": p[\"w_height\"] * upright,\n        \"tilt\": p[\"w_tilt\"] * tilt,\n        \"all_up\": p[\"w_all_up\"] * all_up,\n        \"knee\": p[\"w_knee\"] * knee_low,\n        \"head\": p[\"w_head\"] * head_low,\n        \"act_rate\": p[\"w_action_rate\"] * (da ** 2).sum(1),\n        \"dof_vel\": p[\"w_dof_vel\"] * (s.dof_vel ** 2).sum(1),\n        \"pose\": p[\"w_pose\"] * pose_dev,\n    }\n\n\ndef failed(s, p):\n    h = s.base_pos[:, 2]\n    pitch = nose_up_angle(s.gravity_b)\n    roll = roll_angle(s.gravity_b)\n    return (\n        (h < p[\"fail_height\"])\n        | (roll.abs() > p[\"fail_roll\"])\n        | (pitch.abs() > p[\"fail_pitch\"])\n    )\n","check_attempts":[{"attempt":1,"ok":false,"message":null},{"attempt":1,"ok":true,"message":null}],"train":{"seconds":391.9,"final_mean_reward":72.78,"iterations":null,"iteration":599,"total":600,"curve":[[0,0.3],[1,0.8],[2,1.04],[3,1.25],[4,1.71],[5,2.04],[6,3.07],[7,3.2],[8,4.26],[9,4.54],[10,5.87],[11,6.76],[12,8.66],[13,7.89],[14,9.43],[15,8.97],[16,11.42],[17,14.11],[18,16.17],[19,18.23],[20,19.64],[21,22.66],[22,25.46],[23,27.98],[24,29.63],[25,30.92],[26,31.89],[27,32.85],[28,33.41],[29,34.09],[30,34.58],[31,34.85],[32,35.26],[33,36.17],[34,36.29],[35,37.15],[36,37.62],[37,38.02],[38,38.55],[39,38.82],[40,39.19],[41,39.59],[42,40.04],[43,40.66],[44,40.92],[45,41.52],[46,41.9],[47,42.36],[48,42.86],[49,43.52],[50,44.04],[51,44.38],[52,45.01],[53,45.56],[54,46.07],[55,46.61],[56,47.13],[57,47.69],[58,48.24],[59,48.63],[60,49.11],[61,49.62],[62,50.03],[63,50.42],[64,50.92],[65,51.4],[66,51.76],[67,52.04],[68,52.31],[69,52.57],[70,52.93],[71,53.1],[72,53.38],[73,53.58],[74,53.82],[75,53.95],[76,54.19],[77,54.36],[78,54.52],[79,54.65],[80,54.81],[81,54.92],[82,55.12],[83,55.23],[84,55.38],[85,55.53],[86,55.64],[87,55.74],[88,55.86],[89,56.0],[90,56.08],[91,56.17],[92,56.32],[93,56.43],[94,56.54],[95,56.67],[96,56.78],[97,56.91],[98,57.04],[99,57.15],[100,57.33],[101,57.4],[102,57.53],[103,57.65],[104,57.78],[105,57.92],[106,58.01],[107,58.12],[108,58.25],[109,58.38],[110,58.52],[111,58.6],[112,58.64],[113,58.83],[114,58.88],[115,58.99],[116,59.08],[117,59.12],[118,59.23],[119,59.29],[120,59.43],[121,59.48],[122,59.53],[123,59.61],[124,59.74],[125,59.8],[126,59.85],[127,59.92],[128,60.0],[129,60.04],[130,60.09],[131,60.09],[132,60.17],[133,60.25],[134,60.29],[135,60.33],[136,60.39],[137,60.47],[138,60.46],[139,60.49],[140,60.56],[141,60.63],[142,60.68],[143,60.73],[144,60.76],[145,60.79],[